{"nodes": [{"id": "docs_what_is_done_overview", "label": "Rush Culture Monorepo Status Doc", "file_type": "document", "source_file": "docs/WHAT_IS_DONE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_what_is_done_cacheinterceptor", "label": "CacheInterceptor", "file_type": "rationale", "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered after EncryptInterceptor in AppModule's APP_INTERCEPTOR list so that, given Nest's first-registered-first pipe order, encryption wraps both cache hits and misses on the wire while the cache itself stores only plain ResponseVm."}, {"id": "docs_what_is_done_encryptinterceptor", "label": "EncryptInterceptor", "file_type": "rationale", "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registered before CacheInterceptor so every response, whether served from cache or freshly computed, is encrypted on the wire when ENABLE_ENCRYPTION is on."}, {"id": "docs_what_is_done_clientdevice", "label": "ClientDevice Tracking", "file_type": "concept", "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L93-L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DB upsert is debounced to 5 minutes to avoid write amplification from high-traffic fingerprints, except when a request is rate-limited, in which case the block is recorded immediately so blockedCount stays accurate."}, {"id": "docs_what_is_done_role_customer", "label": "CUSTOMER Role", "file_type": "concept", "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L112-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Represents storefront shoppers (non-staff); documented as having no admin access, distinguishing it from the three staff roles that are actually seeded via permissions.yml role_defaults."}, {"id": "docs_what_is_done_module_config_pattern", "label": "Module-Driven Route/Cache/Security Config Pattern", "file_type": "rationale", "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L47-L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each domain module owns a config/module.yml declaring its routes, auth requirements, cache TTLs, and security settings (encryption, rate limits) so cross-cutting guards/interceptors (RateLimitGuard, CacheInterceptor) can behave generically by reading module config instead of hardcoding per-module logic."}, {"id": "docs_what_is_done_sealed_cookie", "label": "Sealed Session Cookie Design", "file_type": "rationale", "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin session cookie rc_admin_token is AES-GCM sealed rather than a raw JWT so that DevTools no longer exposes JWT claims directly; AuthGuard unseals the cookie via openToken before verifying the JWT payload."}], "edges": [{"source": "docs_what_is_done_overview", "target": "rate_limit_rate_limit_guard_ratelimitguard", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L86-L91", "weight": 1.0}, {"source": "docs_what_is_done_overview", "target": "guards_auth_guard_authguard", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L126-L130", "weight": 1.0}, {"source": "docs_what_is_done_overview", "target": "rbac_permissions_catalog", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/WHAT_IS_DONE.md", "source_location": "L108-L109", "weight": 1.0}, {"source": "docs_what_is_done_overview", "target": "config_modu