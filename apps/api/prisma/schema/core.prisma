model AppConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String  @db.Text
  description String?
  isActive    Boolean @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([isDeleted])
  @@map("app_config")
  @@schema("core")
}

model Discount {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  percentOff       Int?      @map("percent_off")
  amountOffInPaise Int?      @map("amount_off_in_paise")
  minOrderInPaise  Int?      @map("min_order_in_paise")
  maxUses          Int?      @map("max_uses")
  usedCount        Int       @default(0) @map("used_count")
  startsAt         DateTime? @db.Timestamptz(3) @map("starts_at")
  endsAt           DateTime? @db.Timestamptz(3) @map("ends_at")
  isActive         Boolean   @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([isDeleted])
  @@index([userId])
  @@map("discount")
  @@schema("core")
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  isSystem    Boolean @default(false) @map("is_system")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  users           User[]
  rolePermissions RolePermission[]

  @@index([isDeleted])
  @@index([isActive])
  @@map("role")
  @@schema("core")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  module      String
  isActive    Boolean @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  rolePermissions RolePermission[]

  @@index([module])
  @@index([isDeleted])
  @@index([isActive])
  @@map("permission")
  @@schema("core")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@index([isDeleted])
  @@map("role_permission")
  @@schema("core")
}

model UserType {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  users User[]

  @@index([isDeleted])
  @@index([isActive])
  @@map("user_type")
  @@schema("core")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phoneNumber   String?   @unique @map("phone_number")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @db.Timestamptz(3) @map("email_verified")

  roleId     String   @map("role_id")
  role       Role     @relation(fields: [roleId], references: [id])
  userTypeId String   @map("user_type_id")
  userType   UserType @relation(fields: [userTypeId], references: [id])

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  accounts Account[]
  sessions Session[]

  @@index([isDeleted])
  @@index([roleId])
  @@index([userTypeId])
  @@map("user")
  @@schema("core")
}
