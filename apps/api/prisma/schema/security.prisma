model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([isDeleted])
  @@map("account")
  @@schema("security")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isDeleted])
  @@map("session")
  @@schema("security")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@unique([identifier, token])
  @@index([isDeleted])
  @@map("verification_token")
  @@schema("security")
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN

  @@schema("security")
}

model ClientDevice {
  id           String     @id @default(cuid())
  fingerprint  String     @unique
  ip           String
  userAgent    String     @map("user_agent") @db.Text
  deviceType   DeviceType @default(UNKNOWN) @map("device_type")
  os           String?
  browser      String?
  path         String?
  method       String?
  hitCount     Int        @default(1) @map("hit_count")
  blockedCount Int        @default(0) @map("blocked_count")
  lastSeenAt   DateTime   @default(now()) @db.Timestamptz(3) @map("last_seen_at")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([ip])
  @@index([deviceType])
  @@index([lastSeenAt])
  @@index([isDeleted])
  @@map("client_device")
  @@schema("security")
}
