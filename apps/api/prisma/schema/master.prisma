model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  users User[]

  @@index([isDeleted])
  @@index([isActive])
  @@map("role")
  @@schema("master")
}

model UserType {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  users User[]

  @@index([isDeleted])
  @@index([isActive])
  @@map("user_type")
  @@schema("master")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phoneNumber   String?   @unique @map("phone_number")
  name          String?
  image         String?
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @db.Timestamptz(3) @map("email_verified")

  roleId     String   @map("role_id")
  role       Role     @relation(fields: [roleId], references: [id])
  userTypeId String   @map("user_type_id")
  userType   UserType @relation(fields: [userTypeId], references: [id])

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]
  accounts  Account[]
  sessions  Session[]

  @@index([isDeleted])
  @@index([roleId])
  @@index([userTypeId])
  @@map("user")
  @@schema("master")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([isDeleted])
  @@map("account")
  @@schema("master")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isDeleted])
  @@map("session")
  @@schema("master")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@unique([identifier, token])
  @@index([isDeleted])
  @@map("verification_token")
  @@schema("master")
}

model Address {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String  @map("full_name")
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String  @map("postal_code")
  country    String  @default("IN")
  isDefault  Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([userId])
  @@index([isDeleted])
  @@map("address")
  @@schema("master")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?    @map("image_url")
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([isDeleted])
  @@index([userId])
  @@map("category")
  @@schema("master")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?          @db.Text
  brand       String?
  isActive    Boolean          @default(true) @map("is_active")
  categoryId  String?          @map("category_id")
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([categoryId])
  @@index([isActive])
  @@index([isDeleted])
  @@index([userId])
  @@map("product")
  @@schema("master")
}

model ProductVariant {
  id                    String  @id @default(cuid())
  productId             String  @map("product_id")
  product               Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                   String  @unique
  size                  String
  color                 String
  colorHex              String? @map("color_hex")
  priceInPaise          Int     @map("price_in_paise")
  compareAtPriceInPaise Int?    @map("compare_at_price_in_paise")
  stock                 Int     @default(0)
  isActive              Boolean @default(true) @map("is_active")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  cartItems CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([isDeleted])
  @@index([userId])
  @@map("product_variant")
  @@schema("master")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  isDeleted Boolean  @default(false) @map("is_deleted")

  @@index([isDeleted])
  @@index([userId])
  @@map("product_image")
  @@schema("master")
}
