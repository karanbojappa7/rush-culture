DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"
PORT=4000
ENABLE_ENCRYPTION=true
ENCRYPTION_PRIVATE_KEY_B64=
ENCRYPTION_PUBLIC_KEY_B64=
JWT_SECRET=change-me
ADMIN_ORIGIN=http://localhost:4002
STOREFRONT_ORIGIN=http://localhost:4001
ENABLE_CACHING=true
CACHE_TYPE=redis
CACHE_TTL=300
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
ENABLE_EMAIL=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@rushculture.example
SMTP_FROM_NAME=Rush Culture
